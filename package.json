{
  "name": "emuly",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "node --experimental-strip-types scripts/migrate-database.ts --local-only && node bin/server.mjs",
    "build": "next build",
    "start": "node bin/server.mjs --production",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "node node_modules/typescript7/bin/tsc --noEmit",
    "lint:ts5": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --expose-gc --conditions=react-server --test --test-timeout=5000 --experimental-strip-types \"lib/**/*.test.ts\"",
    "emuly": "node bin/emuly.mjs",
    "db:migrate": "node --experimental-strip-types scripts/migrate-database.ts",
    "db:rotate-key": "node --experimental-strip-types scripts/rotate-token-key.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.3",
    "@libsql/client": "0.18.0",
    "@microsoft/dev-tunnels-connections": "1.3.61",
    "@microsoft/dev-tunnels-contracts": "1.3.61",
    "@microsoft/dev-tunnels-management": "1.3.61",
    "@next/env": "16.4.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.10.0",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ssh2": "1.17.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "1.15.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5",
    "typescript7": "npm:typescript@7.0.2"
  },
  "packageManager": "pnpm@12.8.1",
  "bin": {
    "emuly": "bin/emuly.mjs"
  }
}
