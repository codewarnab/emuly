// The codespace that each emuly phone runs in.
// emuly creates it with devcontainer_path=.devcontainer/phone/devcontainer.json, then
// installs Android and starts the runner over the codespace tunnel (lib/phone-setup.ts,
// files from phone/). The server is the one place that installs or updates files, and it
// always sends the scripts that match its own version.
// postStartCommand only restarts what an earlier setup installed (phone/scripts/autostart.sh),
// so a wake does not wait for the server's poll and SSH connect. Before the first setup the
// file does not exist and the command does nothing.
{
  "name": "Emuly phone",
  // GitHub's default codespace image. Hosts keep it cached, so the codespace starts fast,
  // and it already has Node for the runner.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  // The emulator needs the 4-core machine (PHONE_MACHINE in lib/github.ts).
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  // The newest Node LTS for the runner (security fixes). It installs into nvm in the prebuild,
  // and scripts/node-path.sh puts the newest nvm Node first on PATH.
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "lts" } },
  // A prebuild saves the result of onCreateCommand: the Android SDK, the system image and the AVD.
  // Without a prebuild it runs at create time, and setup.sh's lock keeps the server's setup waiting.
  "onCreateCommand": "bash phone/scripts/prebuild.sh",
  "postStartCommand": "bash -c 'f=\"$HOME/emuly/scripts/autostart.sh\"; [ -f \"$f\" ] && bash \"$f\"; exit 0'"
}
