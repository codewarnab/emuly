[Unit]
Description=PhoneLink outbound scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
LoadCredential=endpoint:/etc/phonelink-scheduler/endpoint
LoadCredential=secret:/etc/phonelink-scheduler/secret
ExecStart=/usr/bin/python3 -I /usr/local/lib/phonelink-scheduler/trigger.py
TimeoutStartSec=295
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
SocketBindDeny=any
SystemCallArchitectures=native
LimitCORE=0
MemoryMax=96M
TasksMax=8
