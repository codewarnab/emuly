# Use localhost, not 127.0.0.1, or the OAuth state cookie is lost.
EMULY_BASE_URL=http://localhost:4321
EMULY_GITHUB_CLIENT_ID=
EMULY_GITHUB_CLIENT_SECRET=
# openssl rand -base64 32
EMULY_TOKEN_KEY=
# Only during a key rotation: the previous key. Run pnpm db:rotate-key, then remove it.
# EMULY_TOKEN_KEY_OLD=
EMULY_DB=.data/emuly.db
# Hosted auth foundation only. Leave unset until all remaining consumers migrate.
# EMULY_DATABASE_URL=libsql://your-database.turso.io
# EMULY_DATABASE_AUTH_TOKEN=provided-through-your-secret-manager
EMULY_MAX_TUNNELS=6
# Optional operator safety cap across all users for local testing. Leave unset for no cap.
# GitHub still applies its own codespace limits. Running phones share your hours.
# EMULY_MAX_PHONES=10
# Public template repository and its numeric GitHub repository ID. No repo scope needed.
EMULY_TEMPLATE_REPO=
EMULY_TEMPLATE_REPOSITORY_ID=
EMULY_DEVCONTAINER_PATH=
# Private startup diagnostics. Disabled until isolated acceptance checks pass.
EMULY_DIAGNOSTICS=0
# Limit initial collection to one owned test phone. Leave unset only after rollout review.
# EMULY_DIAGNOSTICS_PHONE=phone-0123456789abcdef
# Optional validated git revision (7-40 lowercase hex characters).
# EMULY_RELEASE=0123456
