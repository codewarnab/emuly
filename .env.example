# GitHub still applies its own codespace limits. Running phones share your hours.
# PHONELINK_MAX_PHONES=10
# Public template repository and its numeric GitHub repository ID. No repo scope needed.
PHONELINK_TEMPLATE_REPO=
PHONELINK_TEMPLATE_REPOSITORY_ID=
PHONELINK_DEVCONTAINER_PATH=
